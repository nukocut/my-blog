---
import '../styles/global.css';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入文章的更新时间，用于 og 标签 */
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
// canonical 用绝对地址；目录型网址补上结尾斜杠（/404.html 这类文件不动）
const pathname = Astro.url.pathname;
const canonicalPath = /\.[a-z0-9]+$/i.test(pathname) ? pathname : `${pathname.replace(/\/+$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://example.com').href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${import.meta.env.BASE_URL}rss.xml`} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 在页面渲染前定好明暗主题，避免闪白 -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
